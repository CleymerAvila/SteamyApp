<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/img_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop" />

  <TextView
    android:id="@+id/tv_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#FFFFFF"
    android:textSize="14sp"
    android:layout_margin="13dp"
    android:textStyle="bold" />



  <ViewFlipper
    android:id="@+id/view_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══ Página 0 ═══ -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="12dp"
      android:gravity="bottom">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <ImageView
          android:id="@+id/store_logo_0"
          android:layout_width="24dp"
          android:layout_height="24dp" />

        <TextView
          android:id="@+id/tv_store_name_0"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textColor="#CCCCCC"
          android:textSize="11sp"
          android:layout_marginStart="4dp" />

        <TextView
          android:id="@+id/tv_deal_price_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#4CAF50"
          android:textSize="16sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tv_retail_price_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#888888"
          android:textSize="11sp"
          android:layout_marginStart="6dp" />

        <TextView
          android:id="@+id/tv_deal_savings_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FF5722"
          android:textSize="12sp"
          android:textStyle="bold"
          android:layout_marginStart="6dp" />
      </LinearLayout>
    </LinearLayout>

    <!-- ═══ Página 1 ═══ -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="12dp"
      android:gravity="bottom">



      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <ImageView
          android:id="@+id/store_logo_1"
          android:layout_width="24dp"
          android:layout_height="24dp" />

        <TextView
          android:id="@+id/tv_store_name_1"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textColor="#CCCCCC"
          android:textSize="11sp"
          android:layout_marginStart="4dp" />

        <TextView
          android:id="@+id/tv_deal_price_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#4CAF50"
          android:textSize="16sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tv_retail_price_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#888888"
          android:textSize="11sp"
          android:layout_marginStart="6dp" />

        <TextView
          android:id="@+id/tv_deal_savings_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FF5722"
          android:textSize="12sp"
          android:textStyle="bold"
          android:layout_marginStart="6dp" />
      </LinearLayout>
    </LinearLayout>

  </ViewFlipper>
</FrameLayout>
